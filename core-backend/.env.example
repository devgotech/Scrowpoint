# ============================================================================
# SCROWPOINT CORE BACKEND (GO) — ENVIRONMENT TEMPLATE (.env.example)
# Ready for Local Development, Test/Staging & Render Cloud Deployment
# ============================================================================

PORT=8080
ENV=development

# Database Configuration (PostgreSQL — auto-injected by Render PostgreSQL in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scrowpoint?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=scrowpoint

# Authentication & Security (auto-generated on Render via generateValue: true)
JWT_SECRET=scrowpoint-production-jwt-secret-key-change-me
JWT_EXPIRATION_HOURS=168

# OAuth 2.0 Providers (POST /api/auth/oauth/{provider} -> google | facebook)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Transactional Email & 6-Digit OTP Delivery (Registration & Password Reset)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_test_scrowpoint_smtp_api_key
SMTP_FROM_EMAIL=security@scrowpoint.com

# Payment Gateway (Paystack Custodial Escrow)
PAYSTACK_SECRET_KEY=sk_test_scrowpoint_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_scrowpoint_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=whsec_test_scrowpoint_paystack_webhook

# Biometric KYC Provider (SmileID NIN / BVN Verification)
SMILE_ID_PARTNER_ID=smile_partner_test_8492
SMILE_ID_API_KEY=smile_api_key_test_9482018492
SMILE_ID_ENVIRONMENT=sandbox

# Internal Microservices & CORS
MEDIA_SERVICE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000


# ============================================================================
# SCROWPOINT CORE BACKEND (GO) — ENVIRONMENT TEMPLATE (.env.example)
# Ready for Local Development, Test/Staging & Render Cloud Deployment
# ============================================================================

PORT=8080
ENV=development

# Database Configuration (PostgreSQL — auto-injected by Render PostgreSQL in production)
# Neon: use the pooled URL above for runtime and the direct URL below for migrations.
DATABASE_URL_UNPOOLED=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scrowpoint?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=scrowpoint

# Authentication & Security (auto-generated on Render via generateValue: true)
JWT_SECRET=scrowpoint-local-dev-jwt-secret-2026
JWT_EXPIRATION_HOURS=168

# OAuth 2.0 Providers (POST /api/auth/oauth/{provider} -> google | facebook)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Transactional Email (verification and password reset links)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=9ccd69976d4996
SMTP_PASSWORD=a024ad5c25f201
SMTP_FROM_EMAIL=from@example.com

# Paystack (use test keys locally/staging; the secret key also validates webhook signatures)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_API_BASE_URL=https://api.paystack.co
FRONTEND_BASE_URL=http://localhost:3000

# Smile ID (sandbox by default; callback must be reachable by Smile ID)
SMILE_ID_PARTNER_ID=your_smile_id_partner_id
SMILE_ID_API_KEY=your_smile_id_api_key
SMILE_ID_ENVIRONMENT=sandbox
SMILE_ID_CALLBACK_URL=https://your-public-https-host/api/kyc/smile/webhook

# Internal Microservices & CORS
MEDIA_SERVICE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
S3_PRIVATE_BUCKET_NAME=scrowpoint-private-media
S3_REGION=eu-west-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=your_storage_access_key
AWS_SECRET_ACCESS_KEY=your_storage_secret_key
MAX_VIDEO_UPLOAD_MB=100

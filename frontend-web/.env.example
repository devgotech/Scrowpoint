# Copy to frontend-web/.env.local (git-ignored) and fill in.
# The browser calls same-origin /api/*; Next.js rewrites it server-side to
# CORE_BACKEND_URL, so switching backends needs no CORS changes.

# Used by plain `npm run dev`, `next build` and `next start`.
CORE_BACKEND_URL=http://localhost:8080

# `npm run dev:local` (defaults to http://localhost:8080 if unset)
LOCAL_CORE_BACKEND_URL=http://localhost:8080

# `npm run dev:staging` — your STAGING Go API on Render.
# Must NOT be the production API (api.scrowpoint.com); the script refuses that.
STAGING_CORE_BACKEND_URL=https://api-staging.scrowpoint.com

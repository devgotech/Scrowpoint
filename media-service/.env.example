# ============================================================================
# SCROWPOINT MEDIA MICROSERVICE (PYTHON / FASTAPI) — ENVIRONMENT TEMPLATE
# Ready for Local Development & Render Cloud Deployment
# ============================================================================

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Local development uses separate folders; only listing_media is served publicly.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/tmp/scrowpoint_media
CDN_BASE_URL=http://localhost:8000/media

# Must match the Go backend JWT_SECRET; this local-only example is not production-safe.
JWT_SECRET=scrowpoint-local-dev-jwt-secret-2026

# Configure both buckets when STORAGE_BACKEND=s3.
S3_PUBLIC_BUCKET_NAME=scrowpoint-public-media
S3_PRIVATE_BUCKET_NAME=scrowpoint-private-media
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# AWS S3: set region (e.g. eu-west-1) and leave S3_ENDPOINT_URL empty.
# Cloudflare R2: set region to "auto" and use
# https://<account-id>.r2.cloudflarestorage.com as S3_ENDPOINT_URL.
S3_REGION=eu-west-1
S3_ENDPOINT_URL=

# Image Processing Limits & Mandatory EXIF Privacy Stripping
MAX_UPLOAD_SIZE_MB=15
MAX_IMAGE_DIMENSION_PX=2048
COMPRESSION_QUALITY=85
STRIP_EXIF=true

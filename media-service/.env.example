# ============================================================================
# BUYER'S HIGH MEDIA MICROSERVICE - ENVIRONMENT TEMPLATE (.env.example)
# ============================================================================

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Storage Provider Configuration (options: 'local' or 's3')
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/tmp/buyers_high_media
CDN_BASE_URL=http://localhost:8000/media

# AWS S3 / Cloud Storage Credentials (required if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=test_aws_key
AWS_SECRET_ACCESS_KEY=test_aws_secret
AWS_REGION=eu-west-1
S3_BUCKET_NAME=buyers-high-secure-media-vault

# Image Processing Limits & EXIF Privacy Stripping
MAX_UPLOAD_SIZE_MB=15
MAX_IMAGE_DIMENSION_PX=2048
COMPRESSION_QUALITY=85
STRIP_EXIF=true

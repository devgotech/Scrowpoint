# ============================================================================
# SCROWPOINT MEDIA MICROSERVICE (PYTHON / FASTAPI) — ENVIRONMENT TEMPLATE
# Ready for Local Development & Render Cloud Deployment
# ============================================================================

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Storage Provider Configuration (options: 'local' or 's3')
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/tmp/scrowpoint_media
CDN_BASE_URL=http://localhost:8000/media

# AWS S3 / Cloudflare R2 Object Storage Credentials (required if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-west-1
S3_BUCKET_NAME=scrowpoint-secure-media-vault

# Image Processing Limits & Mandatory EXIF Privacy Stripping
MAX_UPLOAD_SIZE_MB=15
MAX_IMAGE_DIMENSION_PX=2048
COMPRESSION_QUALITY=85
STRIP_EXIF=true

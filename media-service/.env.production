# ============================================================================
# Scrowpoint MEDIA MICROSERVICE - PRODUCTION PROFILE
# ============================================================================

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Storage Provider Configuration (AWS S3 + CloudFront CDN)
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=/tmp/scrowpoint_media
CDN_BASE_URL=https://cdn.scrowpoint.internal

# AWS S3 Production Credentials
AWS_ACCESS_KEY_ID=your_production_aws_access_key
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_key
AWS_REGION=eu-west-1
S3_BUCKET_NAME=scrowpoint-secure-media-vault

# Image Processing Limits & EXIF Privacy Stripping
MAX_UPLOAD_SIZE_MB=15
MAX_IMAGE_DIMENSION_PX=2048
COMPRESSION_QUALITY=85
STRIP_EXIF=true
